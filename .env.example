# Sao chép file này thành ".env" và điền giá trị thật trước khi chạy
# KHÔNG commit file ".env" thật lên Git (đã có trong .gitignore)

# ---- MQTT ----
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=sensors

# ---- InfluxDB ----
INFLUXDB_URL=http://localhost:8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin12345
INFLUXDB_ORG=pbl4
INFLUXDB_BUCKET=air_quality
INFLUXDB_TOKEN=devtoken12345

# ---- PostgreSQL ----
POSTGRES_USER=aqi_user
POSTGRES_PASSWORD=aqi_pass
POSTGRES_DB=aqi_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- AI service ----
FORECAST_INTERVAL_MINUTES=60
FORECAST_HORIZON_HOURS=24
BACKEND_API_BASE_URL=http://localhost:8000
